in utils;

use ymir_lsp::transport;

use std::stream;

/**
 * A transport reading `input` by chunks of at most `chunk` bytes, and keeping what is sent
 */
@final
pub class MemoryTransport over Transport {

    let mut _input: [c8];

    let _chunk: usize;

    let dmut _output: &StringStream = copy StringStream();

    pub self (input: [c8], chunk: usize = 4096us)
        with _input = input
        , _chunk = chunk
    {}

    pub over receive(mut self, max: usize)-> [c8] {
        let mut n = if (max < self._chunk) { max } else { self._chunk };
        if (n > self._input.len) n = self._input.len;

        let res = self._input[0us .. n];
        self._input = self._input[n .. $];
        res
    }

    pub over send(mut self, data: [c8])-> bool {
        self._output:.write(data);
        true
    }

    pub over close(mut self) {}

    /**
     * @returns: what was sent
     */
    pub fn sent(self)-> [c8] {
        self._output[]
    }
}

/**
 * @returns: the message of body `body`, framed
 */
pub fn frame(body: [c8])-> [c8] {
    "Content-Length: " ~ std::conv::to!{[c8]} (body.len) ~ "\r\n\r\n" ~ body
}
