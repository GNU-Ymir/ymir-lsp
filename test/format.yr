in format;

use ymir_lsp::format;

use std::env;
use std::fs::{errors, sys};

def CASES = ["alignment", "binary", "chains", "comments", "conditions", "declarations", "lists", "spacing", "strings", "uses"];

/**
 * @returns: the source of the case `name` of the resources, and its canonical form
 */
fn case(name: [c8])-> ([c8], [c8])
    throws FsError
{
    let dir = env::currentDir().push("test_resources/format");
    (sys::readFile(dir.push(name ~ ".yr")), sys::readFile(dir.push(name ~ ".fmt")))
}

/**
 * @returns: `text` rewritten by `edits`
 */
fn applied(text: [c8], edits: [TextEdit])-> [c8] {
    let mut res = "";
    let mut from = 0us;
    for e in edits {
        res = res ~ text[from .. e.start] ~ e.text;
        from = e.end;
    }

    res ~ text[from .. $]
}

__test a_source_is_rewritten_in_its_canonical_form {
    for name in CASES {
        let (src, expected) = case(name);
        let f = format::format(name ~ ".yr", src);
        assert(f.text == expected, name);
        assert(applied(src, f.edits) == expected, name);
    }
}

__test the_canonical_form_is_its_own {
    for name in CASES {
        let (_, expected) = case(name);
        let f = format::format(name ~ ".yr", expected);
        assert(f.text == expected && f.edits.len == 0us, name);
    }
}

__test a_range_rewrites_the_declarations_it_is_in {
    let src = "in r;\n\nfn  first() {\n  foo();\n}\n\nfn  second() {\n  bar();\n    baz();\n}\n";
    let start = 50us; // in `bar();`
    let edits = format::formatRange("r.yr", src, start, start + 3us);
    assert(applied(src, edits) == "in r;\n\nfn  first() {\n  foo();\n}\n\nfn second() {\n    bar();\n    baz();\n}\n");

    // a range over both rewrites both
    assert(applied(src, format::formatRange("r.yr", src, 10us, 52us)) == format::format("r.yr", src).text);
}

__test a_source_that_does_not_parse_has_no_canonical_form {
    let mut msg = "";
    {
        format::format("x.yr", "fn main( {\n");
    } catch {
        err: &FormatError => msg = err.msg;
    }

    assert(msg == "the file does not parse");
}

__test the_use_declarations_are_rewritten_importing_and_no_longer_importing_paths {
    let src = "in u;\n\nuse std::io;\nuse std::{conv, fs::path};\n\nfn main () {}\n";
    let add = format::imports("u.yr", src, add-> copy [copy ["shapes"]], remove-> []) ?? [];
    assert(applied(src, add) == "in u;\n\nuse shapes;\n\nuse std::{conv, io};\nuse std::fs::path;\n\nfn main () {}\n");

    let removed = format::imports("u.yr", src, add-> [], remove-> copy [copy ["std", "conv"]]) ?? [];
    assert(applied(src, removed) == "in u;\n\nuse std::io;\nuse std::fs::path;\n\nfn main () {}\n");

    // a path imported already is not added again, and the last one removed takes its line with it
    assert((format::imports("u.yr", src, add-> copy [copy ["std", "io"]], remove-> []) ?? copy [TextEdit(0us, 0us, "")]).len == 0us);
    let only = "in u;\n\nuse std::conv;\n\n/** doc */\nfn main () {}\n";
    assert(applied(only, format::imports("u.yr", only, add-> [], remove-> copy [copy ["std", "conv"]]) ?? []) == "in u;\n\n/** doc */\nfn main () {}\n");
}

__test a_use_is_added_after_the_module_name_when_there_is_none {
    let named = "in u;\n\nfn main () {}\n";
    assert(applied(named, format::imports("u.yr", named, add-> copy [copy ["std", "io"]], remove-> []) ?? []) == "in u;\n\nuse std::io;\n\nfn main () {}\n");

    let unnamed = "fn main () {}\n";
    assert(applied(unnamed, format::imports("u.yr", unnamed, add-> copy [copy ["std", "io"]], remove-> []) ?? []) == "use std::io;\n\nfn main () {}\n");
}

__test the_use_declarations_holding_a_comment_are_not_rewritten {
    let src = "in u;\n\nuse std::io; // printing\nuse std::conv;\n\nfn main () {}\n";
    if let Ok(_) = format::imports("u.yr", src, add-> [], remove-> copy [copy ["std", "conv"]]) {
        assert(false, "a comment would be lost");
    }
}

__test the_path_of_a_use_is_found_by_its_last_segment {
    let src = "in u;\n\nuse std::{conv, fs::path};\n";
    assert(format::importAt("u.yr", src, 27us) ?? [] == ["std", "fs", "path"]);
    assert(format::importAt("u.yr", src, 17us) ?? [] == ["std", "conv"]);
    if let Ok(_) = format::importAt("u.yr", src, 18us) {
        assert(false, "no path ends with a token starting there");
    }
}
