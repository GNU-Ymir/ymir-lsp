in server;

use utils;

use ymir_lsp::{document, server, transport};

use std::env;
use std::config::{access, data};
use std::fs::{errors, sys};

/**
 * @returns: the messages the server sent when given `input`, then `then` once
 * it was idle for a second, and its exit code
 */
fn session(input: [c8], then: [c8] = "")-> ([&Config], i32) {
    let dmut t = copy MemoryTransport(input, then-> then, pause-> 1000u64);
    let dmut c = copy Channel(alias t);
    let dmut s = copy Server(alias c);
    let code = s:.run();

    let dmut out = copy MemoryTransport(t.sent());
    let dmut r = copy Channel(alias out);
    let mut res: [&Config] = [];
    loop {
        if let Ok(b) = r:.receive() {
            res ~= [std::config::json::parse(b)? ?? copy data::None()];
        } else break;
    }

    (res, code)
}

fn request(id: i64, method: [c8], params: [c8])-> [c8] {
    utils::frame("{\"jsonrpc\":\"2.0\",\"id\":" ~ std::conv::to!{[c8]} (id) ~ ",\"method\":\"" ~ method ~ "\",\"params\":" ~ params ~ "}")
}

fn notification(method: [c8], params: [c8])-> [c8] {
    utils::frame("{\"jsonrpc\":\"2.0\",\"method\":\"" ~ method ~ "\",\"params\":" ~ params ~ "}")
}

fn at(doc: [c8], line: i32, character: i32)-> [c8] {
    doc[0us .. $ - 1us] ~ ",\"position\":{\"line\":" ~ std::conv::to!{[c8]} (line) ~ ",\"character\":" ~ std::conv::to!{[c8]} (character) ~ "}}"
}

fn response(msgs: [&Config], id: i64)-> &Config {
    for m in msgs {
        if (m.int("id") ?? -1i64 == id) return m;
    }

    copy data::None()
}

fn names(syms: [&Config])-> [[c8]] {
    copy [s.str("name") ?? "" for s in syms]
}

fn diagnostics(msgs: [&Config])-> [[&Config]] {
    let mut res: [[&Config]] = [];
    for m in msgs if m.str("method") ?? "" == "textDocument/publishDiagnostics" {
        res ~= [m.elements("params", "diagnostics")];
    }

    res
}

__test a_session_answers_from_the_compilation_of_the_document {
    let path = env::currentDir().push("test_resources/server/test1.yr").toStr();
    let uri = Document::ofPath(path);
    let text = "in test1;\n\n/**\n * Adds two numbers\n */\npub fn add (a: i32, b: i32)-> i32 {\n    a + b\n}\n\nfn main () {\n    let x = add (1, 2);\n    let y: i32 = \"oops\";\n}\n";
    let fixed = "in test1;\n\n/**\n * Adds two numbers\n */\npub fn add (a: i32, b: i32)-> i32 {\n    a + b\n}\n\nfn main () {\n    let x = add (1, 2);\n    let y: i32 = x;\n}\n";
    let doc = "{\"textDocument\":{\"uri\":" ~ std::config::json::dump(copy Str(uri)) ~ "}}";

    let input = request(1i64, "textDocument/hover", at(doc, 10, 13))
        ~ request(2i64, "initialize", "{\"capabilities\":{\"general\":{\"positionEncodings\":[\"utf-16\",\"utf-8\"]}}}")
        ~ notification("initialized", "{}")
        ~ notification("textDocument/didOpen", "{\"textDocument\":{\"uri\":" ~ std::config::json::dump(copy Str(uri)) ~ ",\"languageId\":\"ymir\",\"version\":1,\"text\":" ~ std::config::json::dump(copy Str(text)) ~ "}}")
        ~ request(3i64, "textDocument/hover", at(doc, 10, 13))
        ~ request(4i64, "textDocument/definition", at(doc, 10, 13))
        ~ notification("textDocument/didChange", "{\"textDocument\":{\"uri\":" ~ std::config::json::dump(copy Str(uri)) ~ ",\"version\":2},\"contentChanges\":[{\"text\":" ~ std::config::json::dump(copy Str(fixed)) ~ "}]}")
        ~ request(5i64, "textDocument/documentSymbol", doc)
        ~ request(6i64, "workspace/unknown", "{}")
        ~ request(7i64, "shutdown", "null")
        ~ notification("exit", "null");

    let (msgs, code) = session(input);
    assert(code == 0);

    // nothing is answered before the initialization
    assert(response(msgs, 1i64).int("error", "code") ?? 0i64 == -32002i64);

    let caps = response(msgs, 2i64).at("result", "capabilities");
    assert(caps.str("positionEncoding") ?? "" == "utf-8");
    assert(caps.boolean("hoverProvider") ?? false);

    assert(response(msgs, 3i64).str("result", "contents", "value") ?? "" == "test1::add (a: i32, b: i32)-> i32\n\nAdds two numbers");

    let defs = response(msgs, 4i64).elements("result");
    assert(defs.len == 1us && defs[0].str("uri") ?? "" == uri);
    assert(defs[0].int("range", "start", "line") ?? 0i64 == 5i64);

    let syms = response(msgs, 5i64).elements("result");
    assert(copy [s.str("name") ?? "" for s in syms] == ["add", "main"]);

    assert(response(msgs, 6i64).int("error", "code") ?? 0i64 == -32601i64);
    if let data::None() = response(msgs, 7i64).at("result") ?? copy Dict() {} else { assert(false, "shutdown answered with a result"); }

    // the error of the document, and once it is fixed the warning it reports instead of throwing
    let published = diagnostics(msgs);
    assert(published.len == 2us);
    assert(published[0].len == 1us && published[0][0].str("code") ?? "" == "E4095");
    assert(published[1].len == 1us && published[1][0].str("code") ?? "" == "E4038");
    assert(published[1][0].int("severity") ?? 0i64 == 2i64);
}

__test a_hover_is_in_markdown_when_the_client_renders_it {
    let dir = env::currentDir().push("test_resources/server");
    let uri = Document::ofPath(dir.push("hover.yr").toStr());
    let text = sys::readFile(dir.push("hover.yr"));
    let open = notification("textDocument/didOpen", "{\"textDocument\":{\"uri\":" ~ std::config::json::dump(copy Str(uri)) ~ ",\"languageId\":\"ymir\",\"version\":1,\"text\":" ~ std::config::json::dump(copy Str(text)) ~ "}}");
    let hover = request(2i64, "textDocument/hover", at("{\"textDocument\":{\"uri\":" ~ std::config::json::dump(copy Str(uri)) ~ "}}", 40, 5));
    let end = request(3i64, "shutdown", "null") ~ notification("exit", "null");

    let markdown = "{\"capabilities\":{\"textDocument\":{\"hover\":{\"contentFormat\":[\"markdown\",\"plaintext\"]}}}}";
    let (msgs, _) = session(request(1i64, "initialize", markdown) ~ notification("initialized", "{}") ~ open ~ hover ~ end);
    let contents = response(msgs, 2i64).at("result", "contents");
    assert(contents.str("kind") ?? "" == "markdown");
    assert(contents.str("value") ?? "" == sys::readFile(dir.push("hover.md")));

    let (plain, _) = session(request(1i64, "initialize", "{\"capabilities\":{}}") ~ notification("initialized", "{}") ~ open ~ hover ~ end);
    let value = response(plain, 2i64).str("result", "contents", "value") ?? "";
    assert(response(plain, 2i64).str("result", "contents", "kind") ?? "" == "plaintext");
    let signature = "hover::append (a: u32, base: usize, mut ref res: mut [mut c8])-> usize\n\nAppend";
    assert(value.len > signature.len && value[0us .. signature.len] == signature);
}

__test a_session_ended_without_a_shutdown_fails {
    let (msgs, code) = session(request(1i64, "initialize", "{}"));
    assert(msgs.len == 1us && code == 1);
}

__test a_message_that_is_not_json_is_answered_with_an_error {
    let (msgs, _) = session(utils::frame("{not json"));
    assert(msgs.len == 1us);
    assert(msgs[0].int("error", "code") ?? 0i64 == -32700i64);
}

__test a_session_finds_the_declarations_of_the_packages_of_the_workspace {
    let pkg = env::currentDir().push("test_resources/server/pkg");
    let shapes = Document::ofPath(pkg.push("src/shapes.yr").toStr());
    let renamed = "in shapes;\n\npub record Cube {\n    pub let side: i32;\n}\n";
    let doc = "{\"textDocument\":{\"uri\":" ~ std::config::json::dump(copy Str(shapes)) ~ "}}";

    let input = request(1i64, "initialize", "{\"rootUri\":" ~ std::config::json::dump(copy Str(Document::ofPath(pkg.toStr()))) ~ ",\"capabilities\":{}}")
        ~ notification("initialized", "{}");

    let then = request(2i64, "workspace/symbol", "{\"query\":\"Squ\"}")
        ~ request(3i64, "workspace/symbol", "{\"query\":\"sc\"}")
        ~ request(4i64, "workspace/symbol", "{\"query\":\"s\"}")
        ~ request(5i64, "workspace/symbol", "{\"query\":\"println\"}")
        ~ notification("textDocument/didOpen", "{\"textDocument\":{\"uri\":" ~ std::config::json::dump(copy Str(shapes)) ~ ",\"languageId\":\"ymir\",\"version\":1,\"text\":" ~ std::config::json::dump(copy Str(renamed)) ~ "}}")
        ~ request(6i64, "textDocument/hover", at(doc, 2, 12))
        ~ request(7i64, "workspace/symbol", "{\"query\":\"\"}")
        ~ request(8i64, "shutdown", "null")
        ~ notification("exit", "null");

    let (msgs, code) = session(input, then-> then);
    assert(code == 0);
    assert(response(msgs, 1i64).boolean("result", "capabilities", "workspaceSymbolProvider") ?? false);

    let square = response(msgs, 2i64).elements("result");
    assert(square.len >= 1us && square[0].str("name") ?? "" == "Square");
    assert(square[0].int("kind") ?? 0i64 == 23i64 && square[0].str("containerName") ?? "" == "shapes");
    assert(square[0].str("location", "uri") ?? "" == shapes);
    assert(square[0].int("location", "range", "start", "line") ?? 0i64 == 6i64);

    // the overloads once each, and the declarations of the package before the ones of the std
    assert(names(response(msgs, 3i64).elements("result"))[0us .. 2us] == ["scale", "scale"]);
    let all = response(msgs, 4i64).elements("result");
    assert(names(all)[0us .. 5us] == ["Shape", "Side", "Square", "scale", "scale"]);
    assert(all[0].int("kind") ?? 0i64 == 11i64 && all[1].int("kind") ?? 0i64 == 5i64);
    assert(all.len > 5us && all[5].str("location", "uri") ?? "" != shapes);

    let println = response(msgs, 5i64).elements("result");
    assert(println.len >= 1us && println[0].str("containerName") ?? "" == "std::io");

    // the declarations of a changed document replace the ones of its file
    let after = names(response(msgs, 7i64).elements("result"));
    assert("Cube" in after && "Square" !in after && "Color" !in after && "main" in after);
}

fn published(msgs: [&Config], uri: [c8])-> usize {
    let mut res = 0us;
    for m in msgs if m.str("method") ?? "" == "textDocument/publishDiagnostics" && m.str("params", "uri") ?? "" == uri {
        res += 1us;
    }

    res
}

fn edited(uri: [c8], text: [c8])-> [c8] {
    notification("textDocument/didChange", "{\"textDocument\":{\"uri\":" ~ std::config::json::dump(copy Str(uri)) ~ ",\"version\":2},\"contentChanges\":[{\"text\":" ~ std::config::json::dump(copy Str(text)) ~ "}]}")
}

__test a_change_checks_again_only_the_documents_reading_it {
    let dir = env::currentDir().push("test_resources/server");
    let shapes = Document::ofPath(dir.push("pkg/src/shapes.yr").toStr());
    let main = Document::ofPath(dir.push("pkg/src/main.yr").toStr());
    let lib = Document::ofPath(dir.push("lib/src/__lib__.yr").toStr());
    let texts = copy [
        (shapes, "in shapes;\n\npub fn one ()-> i32 {\n    1\n}\n"),
        (main, "mod .shapes;\n\nuse shapes;\n\nfn main () {\n    let _ = one ();\n}\n"),
        (lib, "in __lib__;\n\npub fn two ()-> i32 {\n    2\n}\n")
    ];

    let mut input = request(1i64, "initialize", "{\"capabilities\":{}}") ~ notification("initialized", "{}");
    for t in texts {
        let (uri, text) = t;
        input = input ~ notification("textDocument/didOpen", "{\"textDocument\":{\"uri\":" ~ std::config::json::dump(copy Str(uri)) ~ ",\"languageId\":\"ymir\",\"version\":1,\"text\":" ~ std::config::json::dump(copy Str(text)) ~ "}}");
    }

    let docs = copy ["{\"textDocument\":{\"uri\":" ~ std::config::json::dump(copy Str(t._0)) ~ "}}" for t in texts];
    input = input ~ request(2i64, "textDocument/documentSymbol", docs[0])
        ~ request(3i64, "textDocument/documentSymbol", docs[1])
        ~ request(4i64, "textDocument/documentSymbol", docs[2])
        ~ edited(texts[2]._0, texts[2]._1 ~ "\n")
        ~ request(5i64, "textDocument/documentSymbol", docs[2])
        ~ request(6i64, "textDocument/documentSymbol", docs[0])
        ~ edited(texts[0]._0, texts[0]._1 ~ "\n")
        ~ request(7i64, "textDocument/documentSymbol", docs[1])
        ~ request(8i64, "shutdown", "null")
        ~ notification("exit", "null");

    let (msgs, code) = session(input);
    assert(code == 0);
    assert(names(response(msgs, 6i64).elements("result")) == ["one"]);

    // the package of `lib` reads nothing of the other one, `main` reads `shapes`
    assert(published(msgs, lib) == 2us);
    assert(published(msgs, shapes) == 1us);
    assert(published(msgs, main) == 2us);
}

/**
 * @returns: `text` rewritten by the `TextEdit`s of the protocol `edits`, its
 * characters being bytes
 */
fn applied(text: [c8], edits: [&Config])-> [c8] {
    let mut starts: [usize] = copy [0us];
    for i in 0us .. text.len if text[i] == '\n' {
        starts ~= [i + 1us];
    }

    let mut res = "";
    let mut from = 0us;
    for e in edits {
        let s = starts[cast!usize(e.int("range", "start", "line") ?? 0i64)] + cast!usize(e.int("range", "start", "character") ?? 0i64);
        let t = starts[cast!usize(e.int("range", "end", "line") ?? 0i64)] + cast!usize(e.int("range", "end", "character") ?? 0i64);
        res = res ~ text[from .. s] ~ (e.str("newText") ?? "");
        from = t;
    }

    res ~ text[from .. $]
}

__test a_session_formats_a_document_and_the_declarations_of_a_range {
    let uri = Document::ofPath(env::currentDir().push("test_resources/server/fmt.yr").toStr());
    let text = "in fmt;\n\nfn  first() {\n  foo();\n}\n\nfn  second() {\n  bar();\n}\n";
    let broken = "in fmt;\n\nfn first( {\n";
    let doc = "{\"textDocument\":{\"uri\":" ~ std::config::json::dump(copy Str(uri)) ~ "}";
    let options = ",\"options\":{\"tabSize\":4,\"insertSpaces\":true}";
    let range = ",\"range\":{\"start\":{\"line\":7,\"character\":2},\"end\":{\"line\":7,\"character\":5}}";

    let input = request(1i64, "initialize", "{\"capabilities\":{}}")
        ~ notification("initialized", "{}")
        ~ notification("textDocument/didOpen", "{\"textDocument\":{\"uri\":" ~ std::config::json::dump(copy Str(uri)) ~ ",\"languageId\":\"ymir\",\"version\":1,\"text\":" ~ std::config::json::dump(copy Str(text)) ~ "}}")
        ~ request(2i64, "textDocument/formatting", doc ~ options ~ "}")
        ~ request(3i64, "textDocument/rangeFormatting", doc ~ range ~ options ~ "}")
        ~ notification("textDocument/didChange", "{\"textDocument\":{\"uri\":" ~ std::config::json::dump(copy Str(uri)) ~ ",\"version\":2},\"contentChanges\":[{\"text\":" ~ std::config::json::dump(copy Str(broken)) ~ "}]}")
        ~ request(4i64, "textDocument/formatting", doc ~ options ~ "}")
        ~ request(5i64, "shutdown", "null")
        ~ notification("exit", "null");

    let (msgs, code) = session(input);
    assert(code == 0);

    let caps = response(msgs, 1i64).at("result", "capabilities");
    assert(caps.boolean("documentFormattingProvider") ?? false);
    assert(caps.boolean("documentRangeFormattingProvider") ?? false);

    let whole = "in fmt;\n\nfn first() {\n    foo();\n}\n\nfn second() {\n    bar();\n}\n";
    assert(applied(text, response(msgs, 2i64).elements("result")) == whole);

    // the range is in the second function, the first one is left as it is
    let part = "in fmt;\n\nfn  first() {\n  foo();\n}\n\nfn second() {\n    bar();\n}\n";
    assert(applied(text, response(msgs, 3i64).elements("result")) == part);

    // a document that does not parse has no canonical form
    assert(response(msgs, 4i64).int("error", "code") ?? 0i64 == -32803i64);
}

/**
 * @returns: the diagnostics last published for the document `uri`
 */
fn latest(msgs: [&Config], uri: [c8])-> [&Config] {
    let mut res: [&Config] = [];
    for m in msgs if m.str("method") ?? "" == "textDocument/publishDiagnostics" && m.str("params", "uri") ?? "" == uri {
        res = m.elements("params", "diagnostics");
    }

    res
}

/**
 * @returns: the opening of the document `uri`, and a request checking it
 */
fn opened(uri: [c8], text: [c8], id: i64)-> [c8] {
    let doc = "{\"textDocument\":{\"uri\":" ~ std::config::json::dump(copy Str(uri)) ~ "}}";
    notification("textDocument/didOpen", "{\"textDocument\":{\"uri\":" ~ std::config::json::dump(copy Str(uri)) ~ ",\"languageId\":\"ymir\",\"version\":1,\"text\":" ~ std::config::json::dump(copy Str(text)) ~ "}}")
        ~ request(id, "textDocument/documentSymbol", doc)
}

__test the_diagnostics_carry_the_quick_fixes_of_the_server {
    let dir = env::currentDir().push("test_resources/server");
    let docs = copy [
        (Document::ofPath(dir.push("mutable.yr").toStr()), "in mutable;\n\nuse std::io;\n\nfn main () {\n    let x = 1;\n    x = 2;\n    let a = copy [1, 2];\n    a [0] = 3;\n    println (x, a);\n}\n"),
        (Document::ofPath(dir.push("unused.yr").toStr()), "in unused;\n\nuse std::conv;\nuse std::io;\n\nfn main () {\n    println (1);\n}\n"),
        (Document::ofPath(dir.push("pkg/src/main.yr").toStr()), "mod .shapes;\n\nuse std::io;\n\nfn main () {\n    let s = scale (Square (2), 3);\n    println (s.side);\n}\n")
    ];

    let mut input = request(1i64, "initialize", "{\"capabilities\":{}}") ~ notification("initialized", "{}");
    for i in 0us .. docs.len {
        input = input ~ opened(docs[i]._0, docs[i]._1, 10i64 + cast!i64(i));
    }

    let (msgs, code) = session(input ~ request(2i64, "shutdown", "null") ~ notification("exit", "null"));
    assert(code == 0);

    let titles: [[[c8]]] = copy [
        copy ["Declare x mut", "Declare a dmut"],
        copy ["Remove the use of std::conv"],
        copy ["use shapes"]
    ];

    let mut fixed: [[c8]] = [];
    for i in 0us .. docs.len {
        let (uri, text) = docs[i];
        let diags = latest(msgs, uri);
        assert(diags.len == titles[i].len, uri);

        let mut edits: [&Config] = [];
        for j in 0us .. diags.len {
            let fixes = diags[j].elements("data", "fixes");
            assert(fixes.len != 0us && fixes[0].str("title") ?? "" == titles[i][j], uri);
            edits ~= fixes[0].elements("edit", "changes", uri);
        }

        fixed ~= [applied(text, edits)];
    }

    // once fixed, the documents compile without a diagnostic
    let mut again = request(1i64, "initialize", "{\"capabilities\":{}}") ~ notification("initialized", "{}");
    for i in 0us .. docs.len {
        again = again ~ opened(docs[i]._0, fixed[i], 10i64 + cast!i64(i));
    }

    let (after, _) = session(again ~ request(2i64, "shutdown", "null") ~ notification("exit", "null"));
    for d in docs {
        assert(published(after, d._0) != 0us && latest(after, d._0).len == 0us, d._0);
    }
}
