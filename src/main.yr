mod .ymir_lsp;

use ymir_lsp::{server, sys, transport};

use ymirc::global::common;

use std::{conv, io};
use std::config::_;
use std::config::args::errors;

/**
 * @returns: the port given to the option `name` of `cfg`, none if the option is absent
 * @info: exits the process on a value that is not a port
 */
fn port(cfg: &Config, name: [c8])-> (u16)? {
    if let Ok(v) = cfg.str(name) {
        if let Ok(p) = std::conv::to!{u16} (v)? return p?;
        eprintln("ymir-lsp: invalid port '", v, "' for --", name);
        sys::exit(2i32);
    }

    none
}

fn main(args: [[c8]]) {
    let parser = (copy ArgumentParser())
        :.flag("stdio", comments-> "talk to the client on the standard input and output (default)")
        :.option!{[c8]} ("listen", comments-> "wait for the client to connect on PORT")
        :.option!{[c8]} ("socket", short-> "port", comments-> "connect to the client listening on PORT")
        :.option!{[c8]} ("host", default-> "127.0.0.1", comments-> "the address of --listen and --socket")
        :.flag("version", comments-> "print the version and exit")
        :.defaultHelp();

    let cfg = {
        parser.parse(args)
    } catch {
        HelpRequestError() => {
            println(parser.getHelp(usage-> "ymir-lsp"));
            return;
        }
        err => {
            eprintln(parser.explain(err, usage-> "ymir-lsp"));
            sys::exit(2i32);
            return;
        }
    };

    if (cfg.boolean("version") ?? false) {
        println("ymir-lsp ", server::VERSION, " (ymirc ", common::__YMIR_VERSION__, ")");
        return;
    }

    let host   = cfg.str("host") ?? "127.0.0.1";
    let listen = port(cfg, "listen");
    let socket = port(cfg, "socket");

    let dmut t = {
        if let Ok(p) = listen {
            Transport::listen(host, p)
        } else if let Ok(p) = socket {
            Transport::connect(host, p)
        } else {
            Transport::stdio()
        }
    } catch {
        err: _ => {
            eprintln("ymir-lsp: ", err);
            sys::exit(1i32);
            Transport::stdio()
        }
    };

    let dmut channel = copy Channel(alias t);
    let dmut s       = copy Server(alias channel);
    let code         = s:.run();
    channel:.close();
    sys::exit(code);
}
