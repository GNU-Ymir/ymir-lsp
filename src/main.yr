mod .ymir_lsp;

use ymir_lsp::{server, sys, transport};

use ymirc::global::common;

use std::{conv, io};

def USAGE = "usage: ymir-lsp [--stdio | --listen=PORT | --socket=PORT] [--host=HOST]\n"
    ~ "\n"
    ~ "  --stdio          talk to the client on the standard input and output (default)\n"
    ~ "  --listen=PORT    wait for the client to connect on PORT\n"
    ~ "  --socket=PORT    connect to the client listening on PORT (also --port=PORT)\n"
    ~ "  --host=HOST      the address of --listen and --socket, 127.0.0.1 by default\n"
    ~ "  --version        print the version and exit";

/**
 * @returns: the value of the option `name` at `args[i]`, written `name=value` or
 * `name value`, and the index of the argument after it
 */
fn option(args: [[c8]], i: usize, name: [c8])-> (([c8], usize))? {
    let a = args[i];
    if (a.len > name.len + 1us && a[0us .. name.len] == name && a[name.len] == '=') {
        return (a[name.len + 1us .. $], i + 1us)?;
    }

    if (a == name && i + 1us < args.len) return (args[i + 1us], i + 2us)?;
    none
}

fn main(args: [[c8]]) {
    let mut host = "127.0.0.1";
    let mut listen: (u16)? = none;
    let mut socket: (u16)? = none;
    let mut i = 1us;
    while (i < args.len) {
        let a = args[i];
        if (a == "--version") {
            println("ymir-lsp ", server::VERSION, " (ymirc ", common::__YMIR_VERSION__, ")");
            return;
        }

        if (a == "--help" || a == "-h") {
            println(USAGE);
            return;
        }

        if (a == "--stdio") { i += 1us; continue; }
        if let Ok((v, next)) = option(args, i, "--host") { host = v; i = next; continue; }

        if let Ok((v, next)) = option(args, i, "--listen") {
            if let Ok(p) = std::conv::to!{u16} (v)? { listen = p?; i = next; continue; }
        }

        if let Ok((v, next)) = option(args, i, "--socket") {
            if let Ok(p) = std::conv::to!{u16} (v)? { socket = p?; i = next; continue; }
        }

        if let Ok((v, next)) = option(args, i, "--port") {
            if let Ok(p) = std::conv::to!{u16} (v)? { socket = p?; i = next; continue; }
        }

        eprintln("ymir-lsp: invalid argument '", a, "'\n", USAGE);
        sys::exit(2i32);
    }

    let dmut t = {
        if let Ok(p) = listen { Transport::listen(host, p) }
        else if let Ok(p) = socket { Transport::connect(host, p) }
        else { Transport::stdio() }
    } catch {
        err: _ => {
            eprintln("ymir-lsp: ", err);
            sys::exit(1i32);
            Transport::stdio()
        }
    };

    let dmut channel = copy Channel(alias t);
    let dmut s = copy Server(alias channel);
    let code = s:.run();
    channel:.close();
    sys::exit(code);
}
