/**
 * The compilations of the open documents, and of the packages of the workspace.
 */
in compiled;

use ymir_lsp::unit;

use ymirc::parser;

/**
 * The compilation of a document or of a package, and what it was compiled from
 */
pub record Compiled {

    pub let parser: &Parser;

    // The compilation the document was checked by
    pub let unit: Unit;

    // The text of the document compiled, empty for a package
    pub let text: [c8];

    // The change of the open documents it was compiled after
    pub let generation: u64;

    pub self (parser: &Parser, unit: Unit, text: [c8], generation: u64)
        with parser = parser
        , unit = unit
        , text = text
        , generation = generation
    {}
}
