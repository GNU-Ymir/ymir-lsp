/**
 * The compilations of the targets of the open documents, and of the packages of the workspace.
 */
in compiled;

use ymir_lsp::unit;

use ymirc::parser;

/**
 * The compilation of the open documents of a target, or of a package, and what
 * it was compiled from
 */
pub record Compiled {

    pub let parser: &Parser;

    // The target compiled
    pub let unit: Unit;

    // The texts of the open documents compiled, by path, none for a package
    pub let texts: [[c8] => [c8]];

    // The change of the open documents it was compiled after
    pub let generation: u64;

    pub self (parser: &Parser, unit: Unit, texts: [[c8] => [c8]], generation: u64)
        with parser = parser
        , unit = unit
        , texts = texts
        , generation = generation
    {}

    /**
     * @returns: the text the open document `path` was compiled from, empty if it was not
     */
    pub fn textOf(self, path: [c8])-> [c8] {
        self.texts[path] ?? ""
    }
}
