/**
 * The error codes of the JSON-RPC protocol.
 */
in code;

/**
 * The JSON-RPC error codes the server answers with
 */
pub enum RpcCode : i64
| PARSE_ERROR           = -32700i64
| INVALID_REQUEST       = -32600i64
| METHOD_NOT_FOUND      = -32601i64
| INVALID_PARAMS        = -32602i64
| SERVER_NOT_INITIALIZED = -32002i64
| REQUEST_FAILED        = -32803i64
;
