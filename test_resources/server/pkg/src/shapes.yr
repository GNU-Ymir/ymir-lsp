in shapes;

pub trait Shape {
    pub fn area (self)-> i32;
}

pub record Square {
    pub let side: i32;

    pub self (side: i32)
        with side = side
    {}
}

pub enum Color : i32
| RED  = 1
| BLUE = 2
;

pub def Side: i32;

pub fn scale (s: Square, k: i32)-> Square {
    Square (s.side * k)
}

pub fn scale (s: Square)-> Square {
    s
}
