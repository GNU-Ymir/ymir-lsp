<idea-plugin>
    <id>org.gnu.ymir</id>
    <name>Ymir</name>
    <vendor url="https://github.com/GNU-Ymir">GNU-Ymir</vendor>

    <description><![CDATA[
    Support of the <a href="https://github.com/GNU-Ymir">Ymir</a> language: highlighting of the
    <code>.yr</code> files, and the diagnostics, quick fixes, hover, navigation, usages, outline,
    completion, workspace symbols and formatting of the <code>ymir-lsp</code> language server.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.textmate</depends>
    <depends>com.redhat.devtools.lsp4ij</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable parentId="language"
                                 instance="org.gnu.ymir.intellij.YmirConfigurable"
                                 id="org.gnu.ymir.intellij.YmirConfigurable"
                                 displayName="Ymir"/>
        <newProjectWizard.generator implementation="org.gnu.ymir.intellij.project.YmirNewProjectWizard"/>
        <textmate.bundleProvider implementation="org.gnu.ymir.intellij.YmirTextMateBundleProvider"/>

        <configurationType implementation="org.gnu.ymir.intellij.run.GyllirConfigurationType"/>
        <runConfigurationProducer implementation="org.gnu.ymir.intellij.run.GyllirRunConfigurationProducer"/>
        <postStartupActivity implementation="org.gnu.ymir.intellij.run.GyllirProjectActivity"/>
        <codeInsight.lineMarkerProvider language="textmate"
                                        implementationClass="org.gnu.ymir.intellij.run.YmirRunLineMarkerProvider"/>

        <directoryIndexExcludePolicy implementation="org.gnu.ymir.intellij.project.GyllirExcludePolicy"/>
        <gotoClassContributor implementation="org.gnu.ymir.intellij.symbol.YmirGotoClassContributor"/>
        <gotoSymbolContributor implementation="org.gnu.ymir.intellij.symbol.YmirGotoSymbolContributor"/>
    </extensions>

    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server id="ymir"
                name="Ymir"
                factoryClass="org.gnu.ymir.intellij.YmirLanguageServerFactory">
            <description><![CDATA[
            The Ymir language server, <code>ymir-lsp</code>.
            ]]></description>
        </server>
        <fileNamePatternMapping patterns="*.yr" serverId="ymir" languageId="ymir"/>
    </extensions>

    <actions>
        <action id="Ymir.ReformatCode"
                class="org.gnu.ymir.intellij.format.YmirReformatAction"
                text="Reformat Ymir Code"
                description="Rewrite the Ymir file, or the declarations of its selection, in its canonical form">
            <keyboard-shortcut keymap="$default" first-keystroke="meta alt L"/>
            <add-to-group group-id="CodeFormatGroup" anchor="after" relative-to-action="ReformatCode"/>
        </action>
    </actions>
</idea-plugin>
