<idea-plugin>
    <id>org.gnu.ymir</id>
    <name>Ymir</name>
    <vendor url="https://github.com/GNU-Ymir">GNU-Ymir</vendor>

    <description><![CDATA[
    Support of the <a href="https://github.com/GNU-Ymir">Ymir</a> language: highlighting, indentation,
    formatting and import optimization of the <code>.yr</code> files, the diagnostics, quick fixes,
    hover, navigation, usages, outline, completion, workspace symbols and canonical formatting of the
    <code>ymir-lsp</code> language server, and the debugging of the gyllir packages with gdb.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.textmate</depends>
    <depends>com.redhat.devtools.lsp4ij</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Ymir" displayType="BALLOON"/>
        <applicationConfigurable parentId="language"
                                 instance="org.gnu.ymir.intellij.YmirConfigurable"
                                 id="org.gnu.ymir.intellij.YmirConfigurable"
                                 displayName="Ymir"/>
        <newProjectWizard.generator implementation="org.gnu.ymir.intellij.project.YmirNewProjectWizard"/>
        <textmate.bundleProvider implementation="org.gnu.ymir.intellij.YmirTextMateBundleProvider"/>
        <annotator language="textmate" implementationClass="org.gnu.ymir.intellij.highlight.YmirSelfAnnotator"/>
        <colorSettingsPage implementation="org.gnu.ymir.intellij.highlight.YmirColorSettingsPage"/>
        <additionalTextAttributes scheme="Default" file="colorSchemes/YmirDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/YmirDarcula.xml"/>

        <configurationType implementation="org.gnu.ymir.intellij.run.GyllirConfigurationType"/>
        <runConfigurationProducer implementation="org.gnu.ymir.intellij.run.GyllirRunConfigurationProducer"/>
        <postStartupActivity implementation="org.gnu.ymir.intellij.run.GyllirProjectActivity"/>
        <codeInsight.lineMarkerProvider language="textmate"
                                        implementationClass="org.gnu.ymir.intellij.run.YmirRunLineMarkerProvider"/>

        <directoryIndexExcludePolicy implementation="org.gnu.ymir.intellij.project.GyllirExcludePolicy"/>
        <gotoClassContributor implementation="org.gnu.ymir.intellij.symbol.YmirGotoClassContributor"/>
        <gotoSymbolContributor implementation="org.gnu.ymir.intellij.symbol.YmirGotoSymbolContributor"/>

        <lineIndentProvider implementation="org.gnu.ymir.intellij.format.YmirLineIndentProvider" order="first"/>
        <typedHandler implementation="org.gnu.ymir.intellij.format.YmirTypedHandler"/>
        <enterHandlerDelegate implementation="org.gnu.ymir.intellij.format.YmirEnterHandler" order="first"/>
        <formattingService implementation="org.gnu.ymir.intellij.format.YmirFormattingService" order="first"/>
        <lang.importOptimizer language="textmate" implementationClass="org.gnu.ymir.intellij.imports.YmirImportOptimizer"/>
    </extensions>

    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server id="ymir"
                name="Ymir"
                factoryClass="org.gnu.ymir.intellij.YmirLanguageServerFactory">
            <description><![CDATA[
            The Ymir language server, <code>ymir-lsp</code>.
            ]]></description>
        </server>
        <fileNamePatternMapping patterns="*.yr" serverId="ymir" languageId="ymir"/>

        <debugAdapterServer id="ymir-gdb"
                            name="Ymir (gdb)"
                            factoryClass="org.gnu.ymir.intellij.debug.YmirDebugAdapterFactory">
            <description><![CDATA[
            gdb, through its Debug Adapter Protocol, <code>gdb -i=dap</code>.
            ]]></description>
        </debugAdapterServer>
    </extensions>

    <actions>
        <action id="Ymir.ReformatCode"
                class="org.gnu.ymir.intellij.format.YmirReformatAction"
                text="Reformat Ymir Code"
                description="Format the Ymir file, or the lines of its selection, without the language server">
            <keyboard-shortcut keymap="$default" first-keystroke="meta alt L"/>
            <add-to-group group-id="CodeFormatGroup" anchor="after" relative-to-action="ReformatCode"/>
        </action>
        <action id="Ymir.ReformatWithServer"
                class="org.gnu.ymir.intellij.format.YmirServerReformatAction"
                text="Reformat Ymir Code with ymir-lsp"
                description="Rewrite the Ymir file, or the declarations of its selection, in the canonical form of the language server">
            <add-to-group group-id="CodeFormatGroup" anchor="after" relative-to-action="Ymir.ReformatCode"/>
        </action>
    </actions>
</idea-plugin>
