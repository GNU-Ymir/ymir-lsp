{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Ymir",
  "scopeName": "source.ymir",
  "fileTypes": [
    "yr"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#chars"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#paths"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.ymir",
          "begin": "/\\*[*!](?!/)",
          "end": "\\*/",
          "patterns": [
            {
              "name": "keyword.other.documentation.ymir",
              "match": "@[A-Za-z_]\\w*"
            }
          ]
        },
        {
          "name": "comment.block.ymir",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.ymir",
          "begin": "//",
          "end": "$"
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.ymir",
          "match": "\\\\(u\\{[^}]*\\}|.)"
        }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.ymir",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.ymir"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.ymir"
        }
      },
      "patterns": [
        {
          "include": "$self"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.format.ymir",
          "begin": "\\bf\"\"\"",
          "end": "\"\"\"(s8|s32)?",
          "endCaptures": {
            "1": {
              "name": "storage.type.suffix.ymir"
            }
          },
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.triple.ymir",
          "begin": "\"\"\"",
          "end": "\"\"\"(s8|s32)?",
          "endCaptures": {
            "1": {
              "name": "storage.type.suffix.ymir"
            }
          },
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "string.quoted.double.format.ymir",
          "begin": "\\bf\"",
          "end": "\"(s8|s32)?",
          "endCaptures": {
            "1": {
              "name": "storage.type.suffix.ymir"
            }
          },
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.double.ymir",
          "begin": "\"",
          "end": "\"(s8|s32)?",
          "endCaptures": {
            "1": {
              "name": "storage.type.suffix.ymir"
            }
          },
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        }
      ]
    },
    "chars": {
      "match": "'(\\\\(u\\{[^}]*\\}|.)|[^'\\\\])'(c8|c32)?",
      "captures": {
        "0": {
          "name": "string.quoted.single.ymir"
        },
        "3": {
          "name": "storage.type.suffix.ymir"
        }
      }
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.ymir",
          "match": "\\b0[xX][0-9a-fA-F_]+(i8|u8|i16|u16|i32|u32|i64|u64|is|us)?\\b"
        },
        {
          "name": "constant.numeric.float.ymir",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?(f|d)?\\b"
        },
        {
          "name": "constant.numeric.integer.ymir",
          "match": "\\b[0-9][0-9_]*(i8|u8|i16|u16|i32|u32|i64|u64|is|us|f|d)?\\b"
        }
      ]
    },
    "attributes": {
      "name": "entity.other.attribute-name.ymir",
      "match": "@[A-Za-z_]\\w*"
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn|def|over|macro)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.ymir"
            },
            "2": {
              "name": "entity.name.function.ymir"
            }
          }
        },
        {
          "match": "\\b(class|record|enum|trait|union|entity|impl)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.ymir"
            },
            "2": {
              "name": "entity.name.type.ymir"
            }
          }
        },
        {
          "match": "\\b(mod|in)\\s+([A-Za-z_]\\w*(::[A-Za-z_]\\w*)*)\\s*;",
          "captures": {
            "1": {
              "name": "keyword.other.module.ymir"
            },
            "2": {
              "name": "entity.name.namespace.ymir"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.ymir",
          "match": "\\b(if|else|for|while|loop|break|continue|return|match|throw|catch|yield|await|async|spawn|panic|assert|exit|success|failure|with)\\b"
        },
        {
          "name": "keyword.operator.word.ymir",
          "match": "(!(is|in|of)\\b)|\\b(is|in|of|cast|typeof|typeid|typeinfo|size|expand)\\b"
        },
        {
          "name": "keyword.declaration.ymir",
          "match": "\\b(fn|def|over|macro|class|record|enum|trait|union|entity|impl|mod|use|let|extern|template|throws|skips|__test|__version|__pragma|__dtor|__lib__)\\b"
        },
        {
          "name": "storage.modifier.ymir",
          "match": "\\b(pub|prv|prot|mut|dmut|ref|copy|dcopy|move|alias|const|static|lazy|cte|atomic|unsafe|inline|compile)\\b"
        },
        {
          "name": "constant.language.ymir",
          "match": "\\b(true|false|null|none)\\b"
        },
        {
          "name": "variable.language.ymir",
          "match": "\\b(self|super)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.ymir",
          "match": "\\b(i8|u8|i16|u16|i32|u32|i64|u64|isize|usize|f32|f64|bool|c8|c32|void)\\b"
        },
        {
          "name": "entity.name.type.ymir",
          "match": "\\b[A-Z]\\w*\\b"
        }
      ]
    },
    "paths": {
      "match": "\\b([a-z_]\\w*)(?=::)",
      "captures": {
        "1": {
          "name": "entity.name.namespace.ymir"
        }
      }
    },
    "calls": {
      "patterns": [
        {
          "match": "\\b([a-z_]\\w*)(#)(?=[{(\\[])",
          "captures": {
            "1": {
              "name": "entity.name.function.macro.ymir"
            },
            "2": {
              "name": "keyword.operator.macro.ymir"
            }
          }
        },
        {
          "match": "\\b([a-z_]\\w*)(!)(?!=)",
          "captures": {
            "1": {
              "name": "entity.name.function.call.ymir"
            },
            "2": {
              "name": "keyword.operator.template.ymir"
            }
          }
        },
        {
          "match": "\\b([a-z_]\\w*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.ymir"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.ymir",
          "match": "->|=>"
        },
        {
          "name": "punctuation.separator.namespace.ymir",
          "match": "::"
        },
        {
          "name": "keyword.operator.ymir",
          "match": "[-+*/%=<>!&|^~?:.]+"
        }
      ]
    }
  }
}
